# Copy to infra/docker/.env and adjust as needed.
POSTGRES_USER=ghast
POSTGRES_PASSWORD=ghast
POSTGRES_DB=ghast
POSTGRES_PORT=5432

MINIO_ROOT_USER=ghast
MINIO_ROOT_PASSWORD=ghast12345
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_RAW_BUCKET=ghast-raw-ais

# Required - get a free key at https://aisstream.io
AISSTREAM_API_KEY=

# Optional. JSON array of [[lat,lon],[lat,lon]] corner pairs, one per
# bounding box. Leave unset for the whole planet (fine for Stage 1
# exploration; narrow it once we know which strait/region we're watching).
# Example (Singapore Strait): AISSTREAM_BOUNDING_BOXES=[[[1.0,103.5],[1.5,104.5]]]
AISSTREAM_BOUNDING_BOXES=

# Optional. Comma-separated MMSIs to restrict the stream to (max 200).
AISSTREAM_FILTER_MMSI=

# Optional. Comma-separated AIS Stream message types. Defaults to
# PositionReport,StandardClassBPositionReport,ExtendedClassBPositionReport,ShipStaticData
AISSTREAM_FILTER_MESSAGE_TYPES=
